# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_URL=mongodb://127.0.0.1:27017
# Optional fallback when DB_URL uses mongodb+srv and DNS SRV fails
# Example: mongodb://user:password@host1:27017,host2:27017,host3:27017/?tls=true&replicaSet=<set>&authSource=admin&retryWrites=true&w=majority
DB_URL_FALLBACK=
DB=PremiumEstateDB

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Additional comma-separated CORS origins for deployed frontends
CORS_ORIGINS=https://premium-estate-crm-lostflam.amvera.io

# Admin Configuration (created on first run)
ADMIN_PASSWORD=changeme123
# Set to true once to reset superAdmin password from ADMIN_PASSWORD, then remove
SYNC_ADMIN_PASSWORD=false
ADMIN_EMAIL=admin@gmail.com
ADMIN_FIRST_NAME=Premium
ADMIN_LAST_NAME=Estate
ADMIN_PHONE=7874263694

# Default Users (comma-separated)
DEFAULT_USERS=admin@gmail.com,user@gmail.com

# Email Configuration (for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
# Local dev: ./uploads | Amvera: /data/uploads (set in amvera.yml run command)
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=debug
