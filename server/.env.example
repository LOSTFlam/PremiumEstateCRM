# Server Configuration
PORT=5001
HOST=127.0.0.1
NODE_ENV=development
AUTO_FREE_PORT=true
AUTO_FREE_PORT_FORCE=true
AUTO_FREE_PORT_WAIT_MS=5000

# Database Configuration
DB_URL=mongodb://127.0.0.1:27017
DB=PremiumEstateDB
DB_RETRY_BASE_DELAY_MS=5000
DB_RETRY_MAX_DELAY_MS=60000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Admin Configuration (created on first run)
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@gmail.com
ADMIN_FIRST_NAME=Premium
ADMIN_LAST_NAME=Estate
ADMIN_PHONE=7874263694

# Default Users (comma-separated)
DEFAULT_USERS=admin@gmail.com,user@gmail.com

# Email Configuration (for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=debug
