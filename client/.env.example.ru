# Клиентская Конфигурация

# API Конфигурация
REACT_APP_API_URL=http://localhost:5001
REACT_APP_NODE_ENV=development

# Флаги Функций
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_TRANSLATIONS=true

# Доступные Языки (через запятую)
REACT_APP_AVAILABLE_LANGUAGES=en,ru

# Язык по Умолчанию
REACT_APP_DEFAULT_LANGUAGE=ru

# Конфигурация Карт (опционально - для будущих функций карт)
# REACT_APP_GOOGLE_MAPS_API_KEY=ваш-ключ-google-maps-api
# REACT_APP_MAPBOX_ACCESS_TOKEN=ваш-токен-mapbox

# Конфигурация Загрузки Файлов
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# Пагинация
REACT_APP_ITEMS_PER_PAGE=12
REACT_APP_MAX_ITEMS_PER_PAGE=50

# Конфигурация Кэширования
REACT_APP_CACHE_DURATION=300000

# Включить/Отключить Функции
REACT_APP_ENABLE_FAVORITES=true
REACT_APP_ENABLE_COMPARE=true
REACT_APP_ENABLE_LEAD_FORMS=true
REACT_APP_ENABLE_PDF_EXPORT=true

# Конфигурация Сборки
GENERATE_SOURCEMAP=false
