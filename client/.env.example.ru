# Клиентская Конфигурация

# API Конфигурация
VITE_API_URL=http://localhost:5001

# Флаги Функций
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_TRANSLATIONS=true

# Доступные Языки (через запятую)
VITE_AVAILABLE_LANGUAGES=en,ru

# Язык по Умолчанию
VITE_DEFAULT_LANGUAGE=ru

# Конфигурация Карт (опционально - для будущих функций карт)
# VITE_GOOGLE_MAPS_API_KEY=ваш-ключ-google-maps-api
# VITE_MAPBOX_ACCESS_TOKEN=ваш-токен-mapbox

# Конфигурация Загрузки Файлов
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# Пагинация
VITE_ITEMS_PER_PAGE=12
VITE_MAX_ITEMS_PER_PAGE=50

# Конфигурация Кэширования
VITE_CACHE_DURATION=300000

# Включить/Отключить Функции
VITE_ENABLE_FAVORITES=true
VITE_ENABLE_COMPARE=true
VITE_ENABLE_LEAD_FORMS=true
VITE_ENABLE_PDF_EXPORT=true

# Конфигурация Сборки
GENERATE_SOURCEMAP=false
